# Copy to .env.production on the server, then replace EVERY placeholder with a unique secret.
# Never commit .env.production. Do not reuse development credentials.
ELASTICSEARCH_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
GRAFANA_ADMIN_USER=sentinel-admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
INFLUXDB_USER=sentinel
INFLUXDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
INFLUXDB_TOKEN=REPLACE_WITH_GENERATED_INFLUXDB_TOKEN
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=sentinel
SENTINEL_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Copy this file to .env locally and set strong unique values.
# Never commit .env or reuse these placeholders in a deployed environment.

# Grafana
GRAFANA_ADMIN_USER=change-me
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# InfluxDB
INFLUXDB_USER=change-me
INFLUXDB_PASSWORD=replace-with-a-long-random-password
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=sentinel
INFLUXDB_TOKEN=replace-with-a-generated-token

# Elasticsearch
ELASTICSEARCH_USER=change-me
ELASTICSEARCH_PASSWORD=replace-with-a-long-random-password

# InfluxDB connection (used by Telegraf)
INFLUXDB_URL=http://influxdb:8086
